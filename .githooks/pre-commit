#!/usr/bin/env sh
set -eu

staged_paths=$(git diff --cached --name-only --diff-filter=ACMR)
rust_touched=$(printf '%s\n' "$staged_paths" | grep -E '(\.rs$|Cargo\.toml$|Cargo\.lock$)' || true)

if [ -z "$rust_touched" ]; then
    exit 0
fi

cargo fmt --all -- --check
# Match CI (`.github/workflows/ci.yml`) which lints `--all-targets` so
# test/example/bench code is covered too — avoids "local green, CI red".
cargo clippy --all-targets --no-deps -- -D warnings
